<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\P89Converter\P89Converter.csproj" />
  </ItemGroup>

  <!-- The reference P89 Fichiers are copied next to the assembly so tests read them by relative path. -->
  <ItemGroup>
    <None Update="fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Share the trait vocabulary and the repo-path helper instead of duplicating them. -->
  <ItemGroup>
    <Compile Include="..\TextToXml.Tests\AcTraitCoverage.cs" Link="AcTraitCoverage.cs" />
    <Compile Include="..\TextToXml.Tests\RepoLayout.cs" Link="RepoLayout.cs" />
    <Compile Include="..\TextToXml.Tests\TestCategory.cs" Link="TestCategory.cs" />
  </ItemGroup>

</Project>
