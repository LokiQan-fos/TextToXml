<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <!-- The AR-12 fixture opens SqlConnection / SqlCommand directly to apply scripts/schema/. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- Backs the Category=Unit orchestration tests (Kape22FichierProcessorTests); the transaction and column-length assertions stay on SQL Server (AR-12). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Story 3.3: exercises the real Serilog MSSqlServer sink writing MQTTnetServices.Logs in DoubleJournalIntegrationTests (AR-12). -->
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Runtime skip for the AR-12 integration tests when no SQL Server test instance is reachable. -->
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <!-- Local SQL Server test connection strings (AR-12). Real file is gitignored; the .example is the template. -->
  <ItemGroup>
    <None Include="appsettings.Test.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Test.json')" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kape22Importer\Kape22Importer.csproj" />
  </ItemGroup>

  <!-- Share the trait vocabulary and the repo-path helper with the TextToXml.Tests project instead of duplicating them. -->
  <ItemGroup>
    <Compile Include="..\TextToXml.Tests\TestCategory.cs" Link="TestCategory.cs" />
    <Compile Include="..\TextToXml.Tests\RepoLayout.cs" Link="RepoLayout.cs" />
    <Compile Include="..\TextToXml.Tests\AcTraitCoverage.cs" Link="AcTraitCoverage.cs" />
  </ItemGroup>

</Project>
