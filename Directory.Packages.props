<Project>

  <!-- Central package management. Every PackageReference version lives here so the test projects cannot drift. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- Used directly by the AR-12 test fixture; pinned to the version Microsoft.EntityFrameworkCore.SqlServer 10.0.9 resolves. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <!-- Test-only: lets the Kape22FichierProcessor orchestration tests exercise the persistence branches in Category=Unit without a SQL Server. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <!-- Story 3.0: the importer library takes IConfiguration / ILogger<T> the worker SDK used to supply implicitly; the .Binder / .EnvironmentVariables / .Json packages are test-only, since the library no longer pulls the full Microsoft.Extensions.Configuration stack transitively. All pinned to the version Microsoft.EntityFrameworkCore.SqlServer 10.0.9 resolves. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Story 3.3: the one real Serilog.Sinks.MSSqlServer round-trip test for MQTTnetServices.Logs (FR-14). Test-only; host wiring is Story 3.4. -->
    <PackageVersion Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.MSSqlServer" Version="8.1.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

</Project>
