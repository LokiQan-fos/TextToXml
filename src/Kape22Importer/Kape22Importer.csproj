<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The test project exercises internal seams (Kape22FichierProcessor.SortedByLine, AC-FR6-4). -->
    <InternalsVisibleTo Include="Kape22Importer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core is a sanctioned runtime dependency of the importer (PRD NFR-8, AR-8). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Story 3.0: the library is a pure format component; the host Client (MicroServices.sln) supplies IConfiguration and ILogger<T>. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The default Import section values. Not built or copied; the host Client and ImportOptionsTests read this file by path (AC-FR12-8, CC-7). -->
    <None Include="appsettings.json" />
    <!-- The P60 Descripteur is embedded so it is read from the assembly at runtime, never from disk (AR-5). -->
    <EmbeddedResource Include="..\..\Templates\P60.xml" LogicalName="Kape22Importer.Templates.P60.xml" />
    <!-- The static P60 schema is embedded too: Step 2 validates the normalized XML against it before deserialization (AR-3, AC-FR7-1). -->
    <EmbeddedResource Include="..\..\Templates\P60.xsd" LogicalName="Kape22Importer.Templates.P60.xsd" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TextToXml\TextToXml.csproj" />
    <!--
      PortalSharedLibrary supplies the shared identity and logging used by every portal worker (PRD D20, R-2).
      It lives in the sibling PortalFosMarcegaglia checkout. The reference is conditional so a standalone
      clone of this repository still builds TextToXml and its tests. See README.
    -->
    <ProjectReference Include="..\..\..\..\RiderProjects\PortalFosMarcegaglia\PortalSharedLibrary\PortalSharedLibrary.csproj"
                      Condition="Exists('..\..\..\..\RiderProjects\PortalFosMarcegaglia\PortalSharedLibrary\PortalSharedLibrary.csproj')" />
  </ItemGroup>

</Project>
